diff --git a/output.c b/output.c
index 9f2a708..42e2d65 100644
--- a/output.c
+++ b/output.c
@@ -318,6 +318,10 @@ handle_new_output(struct wl_listener *listener, void *data)
 
 	view_position_all(output->server);
 	update_output_manager_config(output->server);
+
+	/* Touch-Devices, die vor dem ersten Output eintrafen, jetzt mappen
+	 * (wlr_cursor braucht das Output-Mapping fuer die Transform-Berechnung). */
+	seat_map_touch_to_output(output->server->seat);
 }
 
 void
diff --git a/seat.c b/seat.c
index 5f659a4..ef4a140 100644
--- a/seat.c
+++ b/seat.c
@@ -137,22 +137,47 @@ update_capabilities(struct cg_seat *seat)
 static void
 map_input_device_to_output(struct cg_seat *seat, struct wlr_input_device *device, const char *output_name)
 {
-	if (!output_name) {
-		wlr_log(WLR_INFO, "Input device %s cannot be mapped to an output device\n", device->name);
-		return;
+	struct cg_output *output = NULL;
+	struct cg_output *cur;
+
+	if (output_name) {
+		wl_list_for_each (cur, &seat->server->outputs, link) {
+			if (strcmp(output_name, cur->wlr_output->name) == 0) {
+				output = cur;
+				break;
+			}
+		}
 	}
 
-	struct cg_output *output;
-	wl_list_for_each (output, &seat->server->outputs, link) {
-		if (strcmp(output_name, output->wlr_output->name) == 0) {
-			wlr_log(WLR_INFO, "Mapping input device %s to output device %s\n", device->name,
-				output->wlr_output->name);
-			wlr_cursor_map_input_to_output(seat->cursor, device, output->wlr_output);
-			return;
-		}
+	/* HomePanel: Fallback, wenn wlroots/libinput kein output_name liefert
+	 * (bei diesem Build immer der Fall). Kiosk = genau ein Display, daher
+	 * Touchscreen auf das einzige Output mappen, damit wlr_cursor die
+	 * Output-Transformation (hier 270°) korrekt auf die Touch-Koordinaten
+	 * anwendet. */
+	if (output == NULL && !wl_list_empty(&seat->server->outputs)) {
+		output = wl_container_of(seat->server->outputs.next, output, link);
+	}
+
+	if (output != NULL) {
+		wlr_log(WLR_INFO, "Mapping input device %s to output device %s\n", device->name,
+			output->wlr_output->name);
+		wlr_cursor_map_input_to_output(seat->cursor, device, output->wlr_output);
+		return;
 	}
 
-	wlr_log(WLR_INFO, "Couldn't map input device %s to an output\n", device->name);
+	wlr_log(WLR_INFO, "Input device %s cannot be mapped to an output device\n", device->name);
+}
+
+/* HomePanel: Nachruesten – Outputs koennen nach den Input-Devices erscheinen
+ * (DRM- vs. libinput-Enumeration). Sobald ein Output aktiv ist, alle Touch-
+ * Devices (erneut) mappen, damit wlr_cursor die Transform verrechnet. */
+void
+seat_map_touch_to_output(struct cg_seat *seat)
+{
+	struct cg_touch *touch;
+	wl_list_for_each (touch, &seat->touch, link) {
+		map_input_device_to_output(seat, &touch->touch->base, touch->touch->output_name);
+	}
 }
 
