[Unit]
Description=HomePanel Browser View (Xvfb + x11vnc + noVNC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/homepanel/scripts/homepanel-vnc.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target